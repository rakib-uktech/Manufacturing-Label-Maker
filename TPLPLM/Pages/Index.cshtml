                                                    </table>
                                                </div>

                                            </div>


                                        }
                                        else if (Model.listLabel != null)
                                        {
                                            <p>No results found.</p>
                                        }
                                    </div>


                                </div>
                                    
                            </div>

                        </div>
                    </div>

                </div>
            </div>
        </div>

    </div>
       

</body>
</html>


@section Scripts {
    <!-- 🧠 Product Autofill & Label Type Logic -->
    <script>
        document.addEventListener("DOMContentLoaded", function () {
            const workOrderInput = document.getElementById("WorkOrder");
            const itemNoInput = document.getElementById("Item_No");
            const itemNameInput = document.getElementById("Item_Name");
            const internalIdInput = document.getElementById("Internal_Id");
            const customerInput = document.getElementById("Customer");
            const labelTypeInput = document.getElementById("LabelType");
            const buildQtyGroup = document.getElementById("BuildQtyGroup");

            function updateLabelType(itemNo, itemName, customer) {
                const no = itemNo?.trim().toUpperCase() || "";
                const name = itemName?.trim().toUpperCase() || "";
                const cust = customer?.trim().toUpperCase() || "";

                let labelType = "Case";

                if (no.startsWith("FG") && (name.startsWith("STARBUCKS") || cust.startsWith("STARBUCKS"))) {
                    labelType = "SBUX";
                } else if (no.startsWith("KBA")) {
                    labelType = "KBA";
                } else if (no.startsWith("CC")) {
                    labelType = "CC";
                }

                setLabelType(labelType);   // ✅ THIS updates UI + hidden input
                toggleBuildQtyVisibility();
            }


            function toggleBuildQtyVisibility() {
                const value = labelTypeInput.value.trim().toUpperCase();
                buildQtyGroup.style.display = (value === 'KBA' || value === 'CC' || value === 'Shipping') ? 'flex' : 'none';
            }

            workOrderInput.addEventListener("input", function () {
                const matched = productList.find(p => p.Ref_No === this.value);
                if (matched) {
                    itemNoInput.value = matched.Product;
                    itemNameInput.value = matched.Description;
                    internalIdInput.value = matched.intid;
                    updateLabelType(matched.Product, matched.Description);
                } else {
                    itemNoInput.value = "";
                    itemNameInput.value = "";
                    internalIdInput.value = "";
                    labelTypeInput.value = "";
                }
                toggleBuildQtyVisibility();
            });

            itemNoInput.addEventListener("input", function () {
                const matched = productList.find(p => p.Product === this.value);
                if (matched) {
                    itemNameInput.value = matched.Description;
                    internalIdInput.value = matched.intid;
                    updateLabelType(this.value, matched.Description);
                } else {
                    itemNameInput.value = "";
                    internalIdInput.value = "";
                    updateLabelType(this.value, "");
                }
                toggleBuildQtyVisibility();
            });

            labelTypeInput.addEventListener("input", toggleBuildQtyVisibility);
            toggleBuildQtyVisibility(); // Initial run
        });
    </script>

    <!-- 📊 DataTable Initialization & Global Search -->

    <script>
        $(document).ready(function () {
            const tableIds = ['palletTable', 'caseTable', 'kbaTable', 'ccTable', 'sbuxTable', 'shippingTable'];
            const commonTableOptions = {
                paging: true,
                order: [[0, 'desc']], // Default order by first column (id) descending
                dom: 'Bfrtip',
                buttons: [
                    { extend: 'copy', text: '<i class="fas fa-copy"></i>', className: 'btn btn-light btn-sm' },
                    { extend: 'excel', text: '<i class="fas fa-file-excel"></i>', className: 'btn btn-success btn-sm' },
                    { extend: 'pdf', text: '<i class="fas fa-file-pdf"></i>', className: 'btn btn-danger btn-sm' },
                    { extend: 'print', text: '<i class="fas fa-print"></i>', className: 'btn btn-primary btn-sm' }
                ]
            };

            tableIds.forEach(id => {
                $('#' + id).DataTable($.extend(true, {}, commonTableOptions));
            });

            $('#globalSearch').on('keyup', function () {
                tableIds.forEach(id => $('#' + id).DataTable().search(this.value).draw());
            });

            $('a[data-toggle="tab"]').on('shown.bs.tab', function () {
                $.fn.dataTable.tables({ visible: true, api: true }).columns.adjust();
            });
        });
    </script>

    <!-- 📋 Clipboard Copy Utilities -->
    <script>
        function copyToClipboardById(elementId, label) {
            const text = document.getElementById(elementId)?.innerText;
            if (!text) {
                alert(`${label} not found or empty.`);
                return;
            }

            const tempInput = document.createElement('input');
            tempInput.style.position = 'absolute';
            tempInput.style.left = '-9999px';
            tempInput.value = text;
            document.body.appendChild(tempInput);
            tempInput.select();
            document.execCommand('copy');
            document.body.removeChild(tempInput);

            alert(`Copied: ${text}`);
        }

        function copyToClipboardCase() { copyToClipboardById('caseCount', 'Case Count'); }
        function copyToClipboardPallet() { copyToClipboardById('palletCount', 'Pallet Count'); }
        function copyToClipboardKba() { copyToClipboardById('kbaCount', 'KBA Count'); }
        function copyToClipboardCC() { copyToClipboardById('ccCount', 'C&C Count'); }
        function copyToClipboardShipping() { copyToClipboardById('shippingCount', 'Shipping Count'); }
        function copyToClipboardSBUX() { copyToClipboardById('sbuxCount', 'SBUX Count'); }
    </script>

    <!-- 🚫 Form Close Confirmation -->
    <script>
        let recordSubmitted = false;

        function handleFormSubmit() {
            recordSubmitted = true;
        }

        function closeApp() {
            if (recordSubmitted) {
                alert("Please reload the page before closing.");
            } else {
                if (confirm("Are you sure you want to close the application?")) {
                    window.close(); // May only work for windows opened by script
                }
            }
        }
    </script>
    <script>
        function setLabelType(value) {
            const input = document.getElementById("LabelType");

            input.value = value;

            document.querySelectorAll('.label-btn').forEach(btn => {
                btn.classList.toggle('active', btn.dataset.value === value);
            });
        }

        document.addEventListener("DOMContentLoaded", function () {

            // Button clicks
            document.querySelectorAll('.label-btn').forEach(btn => {
                btn.addEventListener('click', function () {
                    setLabelType(this.dataset.value);
                });
            });           
        });
    </script>

    <script>
        const salesOrders = @Html.Raw(JsonConvert.SerializeObject(Model.SalesOrderList));

        document.addEventListener("DOMContentLoaded", function () {

            const salesOrderInput = document.getElementById("SalesOrder");
            const shipAddress = document.getElementById("ShipAddress");
            const shipAddressCard = document.getElementById("ShipAddressCard");
            const salesOrderInternalId = document.getElementById("SalesOrderInternalId");

            salesOrderInput.addEventListener("input", function () {

                const selected = salesOrders.find(s => s.SalesOrder === this.value);

                if (selected) {
                    shipAddress.value = selected.ShipAddress || "";
                    salesOrderInternalId.value = selected.SalesOrderInternalId;

                    shipAddressCard.style.display = "block";

                    // Automatically select Shipping label
                    setLabelType("Shipping");
                }
                else {
                    shipAddress.value = "";
                    salesOrderInternalId.value = "";

                    shipAddressCard.style.display = "none";

                    // Revert back to Case
                    setLabelType("Case");
                }

                // Update Build Qty visibility
                toggleBuildQtyVisibility();
            });

        });
    </script>

}
