<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/png" href="~/images/tags-solid.svg" />
    <title>@ViewData["Title"] - TPLPLM</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/TPLPLM.styles.css" asp-append-version="true" />
   
    <!-- Bootstrap Icons -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons/font/bootstrap-icons.css" rel="stylesheet">
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>

    <!-- Bootstrap Icons -->
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons/font/bootstrap-icons.css" />
    <!-- Font Awesome (Optional, for more icons) -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/5.15.4/css/all.min.css" />
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css" rel="stylesheet">


    <!-- Bootstrap CSS -->
    <link rel="stylesheet" href="https://stackpath.bootstrapcdn.com/bootstrap/5.1.3/css/bootstrap.min.css" />

    <!-- Bootstrap and Chart.js CDN -->
    <link rel="stylesheet" href="https://stackpath.bootstrapcdn.com/bootstrap/5.1.3/css/bootstrap.min.css">
    <script src="https://cdnjs.cloudflare.com/ajax/libs/Chart.js/3.7.1/chart.min.js"></script>

    <!-- jQuery and Bootstrap Scripts -->
    <script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
    <!-- In <head> -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">

    <!-- Before closing tag -->
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
    <style>
        #globalLoader {
            position: fixed;
            inset: 0;
            background: rgba(255, 255, 255, 0.85);
            z-index: 9999;
            display: flex;
            align-items: center;
            justify-content: center;
        }

            #globalLoader.hide {
                opacity: 0;
                pointer-events: none;
                transition: opacity 0.25s ease;
            }
    </style>

</head>
<body>
    <!-- Global Page Loader -->
    <div id="globalLoader" class="hide">
        <div class="text-center">
            <div class="spinner-border text-primary"></div>
            <div class="mt-3 fw-semibold">Loading, please wait…</div>
        </div>
    </div>

    <header>
        <nav class="navbar navbar-expand-sm navbar-light bg-white border-bottom box-shadow mb-3">
            <div class="container-fluid">
                <div class="row w-100 align-items-center">
                    <!-- Left: Logo -->
                    <div class="col-4 col-sm-3 d-flex align-items-center">
                        <a class="navbar-brand" asp-area="" asp-page="/Index">
                            <img src="~/images/mono.jpg" height="50" width="220" alt="Brand Logo" class="img-fluid" />
                        </a>
                    </div>

                    <!-- Center: Title -->
                    <div class="col-4 col-sm-6 text-center">
                        <span class="h5 h4-sm text-primary fw-bold">Label Maker</span>
                    </div>

                    <!-- Right: Login + Help Link -->
                    <div class="col-4 col-sm-3 d-flex justify-content-end align-items-center gap-3">
                        <a class="nav-link" asp-page="/Help">
                            <i class="bi bi-question-circle me-1"></i> Get Help
                        </a>
                        <div class="collapse navbar-collapse justify-content-end">
                            <ul class="navbar-nav mb-2 mb-lg-0">
                                <partial name="_LoginPartial" />
                            </ul>
                        </div>
                    </div>
                </div>
            </div>
        </nav>
    </header>

    <div class="container-fluid">
        <main role="main" class="pb-3">
            @RenderBody()
        </main>
    </div>

    
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>

    @await RenderSectionAsync("Scripts", required: false)

    <!-- Bootstrap Bundle -->
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
    <!-- DataTables -->
    <script src="https://code.jquery.com/jquery-3.5.1.min.js"></script>
    <script src="https://cdn.datatables.net/1.11.5/js/jquery.dataTables.min.js"></script>

    <!-- Custom JS to toggle login menu -->
    <script>
        document.addEventListener("DOMContentLoaded", function () {
            const toggler = document.getElementById("customNavbarToggler");
            const collapse = document.getElementById("customNavbarCollapse");

            if (toggler && collapse) {
                toggler.addEventListener("click", function () {
                    collapse.classList.toggle("show");
                });

                // Close on nav-link click (optional)
                collapse.querySelectorAll(".nav-link").forEach(link => {
                    link.addEventListener("click", () => {
                        const isDropdownToggle = link.classList.contains("dropdown-toggle");
                        if (!isDropdownToggle) {
                            collapse.classList.remove("show");
                        }
                    });
                });
            }
        });
    </script>
    @section Scripts {
        <partial name="_ValidationScriptsPartial" />
    }
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"
            integrity="sha384-sVIRfTeC8OC8DYwACqHqfYAhv/0M1eRQthk/0UpYwhhXo0H7yVaWdEY3S99lPaFI"
            crossorigin="anonymous"></script>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>
    <script>
        (function () {
            const loader = document.getElementById("globalLoader");
            if (!loader) return;

            // Always hide loader on page show
            window.addEventListener("pageshow", function () {
                loader.classList.add("hide");
            });

            // Show loader ONLY for real navigation
            document.addEventListener("click", function (e) {
                const link = e.target.closest("a.js-nav-link");
                if (!link) return;

                // Ignore dropdown toggles
                if (link.dataset.bsToggle) return;

                // Ignore anchors
                if (link.getAttribute("href") === "#") return;

                e.preventDefault();
                loader.classList.remove("hide");

                setTimeout(() => {
                    window.location.href = link.href;
                }, 50);
            });
        })();
    </script>
</body>
</html>