@model TPLPLM.Pages.PrintModel

<!-- Include JsBarcode CDN -->
<script src="https://cdn.jsdelivr.net/npm/jsbarcode@3.11.5/dist/JsBarcode.all.min.js"></script>

<div class="label-preview case-label" style="width:400px; border:1px solid #000; padding:10px; font-family:Arial, sans-serif; font-size:11px;">

    <!-- Header with Logo + Barcode -->
    <div class="label-header" style="display:flex; align-items:center; margin-bottom:10px;">
        <!-- Smaller logo -->
        <img src="/images/mono.jpg" alt="Logo" style="height:35px; margin-right:15px;" />
        <div class="barcode" style="flex:1;">
            <!-- Smaller top barcode -->
            <svg id="labelBarcode" style="height:30px; width:160px;"></svg>
            <script>
                JsBarcode("#labelBarcode", "@Model.labelinfo.Label_No", {
                    format: "CODE128",
                    lineColor: "#000",
                    width: 1.5,
                    height: 30,
                    displayValue: true,
                    fontSize: 8
                });
            </script>
        </div>
    </div>

    <!-- Address -->
    @if (!string.IsNullOrEmpty(Model.Address))
    {
        <div style="margin-bottom:10px;">
            <p style="font-size:9px; margin:0;">@Model.Address</p>
            <hr style="border:2px solid #000; margin-top:5px;" />
        </div>
    }

    <!-- Standard rows -->
    <p>
        <strong>Client:</strong> <span style="font-size:16px;">@(string.IsNullOrWhiteSpace(Model.AssemblyItem?.Custitem13)? "N/A"
                                        :@Model.AssemblyItem?.Custitem13)</span></p>
    <p>
        <strong>Customer SKU:</strong> @(string.IsNullOrWhiteSpace(Model.AssemblyItem?.Custitemproduct_Spec_Sku)? "N/A"
                                    :@Model.AssemblyItem?.Custitemproduct_Spec_Sku)</p>
    <p>
        <strong>Reference:</strong> @(string.IsNullOrWhiteSpace(Model.AssemblyItem?.Custitem17)? "N/A"
                                    :@Model.AssemblyItem?.Custitem17)</p>

    <!-- Wrapped Description -->
    <p style="word-wrap:break-word; max-width:280px;">
        <strong>Description:</strong>
                @(string.IsNullOrWhiteSpace(Model.AssemblyItem?.Description)? "N/A"
                : Model.AssemblyItem.Description)
    </p>

    <!-- Inline Case Row -->
    <div style="display:flex; justify-content:space-between; margin-bottom:8px;">
        <span>
            <strong>Case Qty:</strong>
            @(decimal.TryParse(Model.AssemblyItem?.Custitemproduct_Spec_Qtyperouter as string, out decimal qty)
                        ? Math.Round(qty).ToString("0")
                        : "N/A")
        </span>
        <span>
            <strong>Case Weight:</strong>
            @(Model.AssemblyItem?.Custitemproduct_Spec_Casewtgrosskg != null
                        ? $"{Model.AssemblyItem.Custitemproduct_Spec_Casewtgrosskg} KG"
                        : "N/A")
        </span>
    </div>

    <!-- Date/Product Code/Our Ref/Case Number Table -->
    <table style="width:100%; border-collapse:collapse; border:2px solid #000; margin-bottom:10px;">
        <tr>
            <td style="border-right:2px solid #000; padding:4px;"><strong>Date Produced:</strong></td>
            <td style="padding:4px;">@Model.labelinfo.Create_Date</td>
            <td rowspan="2" style="text-align:center; vertical-align:middle; padding:4px;">
                <img src="/images/22PAP.png" alt="22PAP" style="height:50px;" />
            </td>
        </tr>
        <tr>
            <td style="border-right:2px solid #000; padding:4px;"><strong>Product Code:</strong></td>
            <td style="padding:4px;">
                @(string.IsNullOrWhiteSpace(Model.AssemblyItem?.Custitemproduct_Spec_Productcode)? "N/A"
                :@Model.AssemblyItem?.Custitemproduct_Spec_Productcode)</td>
        </tr>
        <tr>
            <td style="border-right:2px solid #000; padding:4px;"><strong>Our Ref:</strong></td>
            <td style="padding:4px;">@(string.IsNullOrWhiteSpace(Model.AssemblyItem?.ItemId)? "N/A"
                :@Model.AssemblyItem?.ItemId)</td>
            <td style="padding:4px;"><strong>Case Number:</strong> @Model.labelinfo.Label_No</td>
        </tr>
    </table>

    <!-- GS1-128 Barcode -->
    @if (!string.IsNullOrWhiteSpace(Model.AssemblyItem?.Custitemproduct_Spec_Gtin))
    {
        var paddedGtin = Model.AssemblyItem.Custitemcustom_Product_Sepc_Case_Gtin.PadLeft(13, '0');
        var caseGtinValue = "02" + paddedGtin;
        var readableCaseGtin = "(02)" + paddedGtin;
        <div style="margin-top:5px;">
            <p style="margin:0;"><strong>Case GTIN:</strong> @readableCaseGtin</p>
            <svg id="gs1Barcode" style="height:30px; width:160px; margin-top:5px;"></svg>
            <script>
                JsBarcode("#gs1Barcode", "@caseGtinValue", {
                    format: "CODE128",
                    lineColor: "#000",
                    width: 1.5,
                    height: 30,
                    displayValue: true,
                    fontSize: 8
                });
            </script>
        </div>
    }

</div>
